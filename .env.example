# Configuración del monitoreo. Sintaxis bash: el instalador la carga con `source`.
# Copia este archivo a .env (no se versiona) y complétalo en el servidor.
# Docker Compose no lee este archivo: usa ~/.config/monitoreo/compose.env, que genera el instalador.

SERVIDOR_NOMBRE="Server"

# Telegram: crea el bot con @BotFather y escríbele una vez. El chat_id sale de
# https://api.telegram.org/bot<token>/getUpdates. El token NO va aquí: install.sh
# lo pide la primera vez y lo guarda en ~/.config/monitoreo/secretos.
TELEGRAM_CHAT_ID=""

# Latido externo opcional (healthchecks.io u otro). Alertmanager lo llama cada 5
# minutos; si deja de llegar, ese servicio avisa aunque el servidor no tenga red.
HEALTHCHECKS_URL=""

# Red
INTERFAZ_RED="eth0"
GATEWAY_LAN="192.168.1.1"
DESTINO_INTERNET="1.1.1.1"

# URL pública de Grafana si se publica por el túnel de Cloudflare (https://dominio).
# Ajusta enlaces y redirecciones. Vacío = solo por túnel SSH en localhost:3000.
# Publícalo SIEMPRE detrás de una aplicación de Cloudflare Access.
GRAFANA_URL_PUBLICA=""

# Puerto de métricas de cloudflared (install-host.sh lo muestra). Debe ser fijo:
# sin --metrics explícito, cloudflared elige uno distinto en cada arranque.
CLOUDFLARED_METRICAS_PUERTO="20250"

# Apps:"nombre|url-interna|url-externa". La url externa es opcional.
APPS=(
  "miapp|http://127.0.0.1:8081|https://miapp.ejemplo.com"
)

# Servicios systemd del sistema que deben estar siempre activos.
UNIDADES_SISTEMA_CRITICAS=(
  docker.service
  cloudflared-tunel.service
  ssh.service
  fail2ban.service
  cron.service
  systemd-journald.service
  systemd-resolved.service
  systemd-timesyncd.service
  NetworkManager.service
  unattended-upgrades.service
  prometheus-node-exporter.service
)

# Servicios systemd de usuario que deben estar siempre activos. Con Docker suele quedar vacío:
# las apps son contenedores y las vigila ContenedorDetenido.
UNIDADES_USUARIO_CRITICAS=()

# Contenedores que pueden estar detenidos sin alertar (regex, vacío = ninguno).
CONTENEDORES_EXCLUIDOS=""

# Puertos que pueden escuchar en todas las interfaces (0.0.0.0 / [::] / *).
PUERTOS_PUBLICOS_PERMITIDOS=(22)

# Contenedor PostgreSQL a vigilar. Vacío = no instalar postgres-exporter.
POSTGRES_CONTENEDOR=""
POSTGRES_PUERTO="5432"
# Base a la que se conecta postgres-exporter (pg_monitor ve las estadísticas de todas).
# La imagen oficial solo crea "postgres" si POSTGRES_DB no se cambió.
POSTGRES_BASE="postgres"
