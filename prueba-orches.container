[Unit]
Description=Prueba de orches: whoami en 127.0.0.1:18080

[Container]
ContainerName=prueba-orches
Image=docker.io/traefik/whoami@sha256:c4717a8d1f0134a7444e24f881160e033991f23027c6c5a9a3f8fd22e70d1d44
Label=monitoreo.upstream=traefik/whoami:v1.12.0
Exec=--port 8080 --name v1
PublishPort=127.0.0.1:18080:8080
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=always

[Install]
WantedBy=default.target
