# Copia estos bloques a %USERPROFILE%\.ssh\config

# Desde cualquier lugar, por el túnel de Cloudflare
Host servidor-mon
    HostName ssh.ejemplo.com
    User TU_USUARIO
    IdentityFile ~/.ssh/id_ed25519
    ProxyCommand cloudflared access ssh --hostname %h
    LocalForward 13000 127.0.0.1:3000
    LocalForward 19090 127.0.0.1:9090
    ServerAliveInterval 30
    ExitOnForwardFailure yes

# Solo dentro de la LAN
Host servidor-mon-lan
    HostName 192.168.1.10
    Port 22
    User TU_USUARIO
    IdentityFile ~/.ssh/id_ed25519
    LocalForward 13000 127.0.0.1:3000
    LocalForward 19090 127.0.0.1:9090
    ServerAliveInterval 30
    ExitOnForwardFailure yes
