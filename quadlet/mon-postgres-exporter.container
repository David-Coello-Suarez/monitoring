[Unit]
Description=Monitoreo: métricas de PostgreSQL
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mon-postgres-exporter
Image=docker.io/prometheuscommunity/postgres-exporter@sha256:ac5ec343104fae0e2d84a27bb8d69b38430a11910c5382cad85d478d2bab713e
Label=monitoreo.upstream=prometheuscommunity/postgres-exporter:v0.20.1
Network=host
EnvironmentFile=%h/.config/monitoreo/postgres-exporter.env
Secret=mon-pg-password,type=mount,target=/run/secrets/pg-password,uid=65534,gid=65534,mode=0400
Exec=--web.listen-address=127.0.0.1:9187
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
