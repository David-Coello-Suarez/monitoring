[Unit]
Description=Monitoreo: métricas de contenedores Podman
Wants=network-online.target
After=network-online.target
Wants=podman.socket
After=podman.socket

[Container]
ContainerName=mon-podman-exporter
Image=quay.io/navidys/prometheus-podman-exporter@sha256:b32899364b6761e2f4f496f110f2bc91a6cbab064f737c19efff200f7f3a25bf
Label=monitoreo.upstream=navidys/prometheus-podman-exporter:v1.21.2
Network=host
UserNS=keep-id:uid=65534
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Volume=%t/podman/podman.sock:/run/podman/podman.sock
Exec=--collector.enable-all --collector.enhance-metrics --web.listen-address=127.0.0.1:9882
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
