[Unit]
Description=Monitoreo: Alertmanager (avisos por Telegram)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mon-alertmanager
Image=docker.io/prom/alertmanager@sha256:39d8bb3966c694a124428a3a88fbcffd40bd069129ecd47c059f8a3f17c55f3b
Label=monitoreo.upstream=prom/alertmanager:v0.34.2
Network=host
Volume=mon-alertmanager:/alertmanager:U
Volume=%h/.config/monitoreo/alertmanager:/etc/alertmanager:ro
Secret=mon-telegram-token,type=mount,target=/run/secrets/telegram-token,uid=65534,gid=65534,mode=0400
Exec=--config.file=/etc/alertmanager/alertmanager.yml --storage.path=/alertmanager --web.listen-address=127.0.0.1:9093 --cluster.listen-address=
HealthCmd=["wget","-q","-O","/dev/null","http://127.0.0.1:9093/-/healthy"]
HealthInterval=30s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=30s
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
