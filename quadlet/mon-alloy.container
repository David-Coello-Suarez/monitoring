[Unit]
Description=Monitoreo: Alloy (recolector del journal)
Wants=network-online.target
After=network-online.target
Wants=mon-loki.service
After=mon-loki.service

[Container]
ContainerName=mon-alloy
Image=docker.io/grafana/alloy@sha256:8ab871206bd2d8f89277f53abffee5f452a293980788d52f85fa183a87a505a4
Label=monitoreo.upstream=grafana/alloy:v1.21.3
Network=host
# /var/lib/alloy es 0770 de alloy (473); el uid del host sigue siendo 1000 para la ACL del journal.
UserNS=keep-id:uid=473,gid=473
Volume=mon-alloy:/var/lib/alloy/data:U
Volume=%h/.config/monitoreo/alloy/config.alloy:/etc/alloy/config.alloy:ro
Volume=/var/log/journal:/var/log/journal:ro
Volume=/etc/machine-id:/etc/machine-id:ro
Tmpfs=/tmp:rw,size=64m,mode=0755,U
Exec=run --storage.path=/var/lib/alloy/data --server.http.listen-addr=127.0.0.1:12345 /etc/alloy/config.alloy
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
