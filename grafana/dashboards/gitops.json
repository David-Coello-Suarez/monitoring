   "title": "Historial",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 16,
   "type": "state-timeline",
   "title": "Sincronización en el tiempo",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "monitoreo_orches_sincronizado",
     "legendFormat": "sincronización",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(monitoreo_unidad_usuario{unit=\"orches.service\",active=\"active\"}) or vector(0)",
     "legendFormat": "servicio orches",
     "refId": "B",
     "instant": false,
     "range": true
    }
   ],
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "OK",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "Fallo",
         "color": "red",
         "index": 1
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 17,
   "type": "logs",
   "title": "Cambios aplicados y errores",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "refId": "A",
     "expr": "{contenedor=\"systemd-orches\"} |~ `Added|Modified|Removed|Initialized|(?i)error|failed`"
