    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 13,
   "type": "table",
   "title": "Unidades de la raíz del repositorio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Cada .container, .network o .service de la raíz de la rama podman y su estado en systemd.",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 16,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "monitoreo_orches_unidad * on (unit) group_left (active, sub) monitoreo_unidad_usuario",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "servidor": true
      },
      "renameByName": {
       "archivo": "archivo en el repo",
       "unit": "servicio",
       "active": "estado",
       "sub": "detalle"
      },
      "indexByName": {
       "archivo": 0,
       "unit": 1,
       "active": 2,
       "sub": 3
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "estado"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "active": {
            "text": "activo",
            "color": "green"
           },
           "failed": {
            "text": "fallido",
            "color": "red"
           },
           "inactive": {
            "text": "inactivo",
            "color": "orange"
           },
           "activating": {
            "text": "arrancando",
            "color": "yellow"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "archivo en el repo"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Ver en GitHub",
          "url": "https://github.com/David-Coello-Suarez/monitoring/blob/podman/${__value.raw}",
          "targetBlank": true
         }
        ]
       }
      ]
     }
    ]
   }
  },
  {
   "id": 14,
   "type": "text",
   "title": "Repositorio",
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "options": {
    "mode": "markdown",
    "content": "**Fuente de verdad:** rama `podman` de `David-Coello-Suarez/monitoring`.\n\n- [Archivos de la rama](https://github.com/David-Coello-Suarez/monitoring/tree/podman)\n- [Historial de commits](https://github.com/David-Coello-Suarez/monitoring/commits/podman)\n\nPara desplegar, cambiar o quitar un servicio: sube, edita o borra un `.container` en la **raíz** de la rama. orches lo aplica en unos 2 minutos.\n\nTras una baja, ejecuta `systemctl --user reset-failed <unidad>.service`."
   }
  },
  {
   "id": 15,
