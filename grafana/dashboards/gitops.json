{
 "uid": "mon-gitops",
 "title": "GitOps (orches)",
 "tags": [
  "servidor",
  "gitops"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "links": [
  {
   "title": "Rama podman en GitHub",
   "type": "link",
   "url": "https://github.com/David-Coello-Suarez/monitoring/tree/podman",
   "targetBlank": true,
   "icon": "external link"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Estado de la sincronización",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Sincronización",
   "description": "Compara el commit desplegado por orches con el último de la rama podman en GitHub.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "monitoreo_orches_sincronizado",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "text": {
     "valueSize": 28
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "Sin datos",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Sincronizado",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "Desincronizado",
         "color": "red",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "links": []
    },
    "overrides": []
   }
  },
