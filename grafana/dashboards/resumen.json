      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "estado"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "active": {
            "color": "green"
           },
           "failed": {
            "color": "red"
           },
           "activating": {
            "color": "orange"
           },
           "inactive": {
            "color": "gray"
           }
          }
