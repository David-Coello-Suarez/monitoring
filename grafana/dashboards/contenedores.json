{
 "uid": "mon-contenedores",
 "title": "Contenedores",
 "tags": [
  "servidor",
  "podman"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "table",
   "title": "Estado",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "podman_container_state{name=~\"$contenedor\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "podman_container_health{name=~\"$contenedor\"}",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - podman_container_started_seconds{name=~\"$contenedor\"}",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "servidor": true,
       "id": true,
       "pod_id": true,
       "image_id": true,
       "ports": true,
       "created": true
      },
      "renameByName": {
       "name": "contenedor",
       "pod_name": "pod",
       "image": "imagen",
       "Value #A": "estado",
       "Value #B": "salud",
       "Value #C": "arriba hace"
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "estado"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "-1": {
            "text": "desconocido",
            "color": "gray"
           },
           "0": {
            "text": "creado",
            "color": "yellow"
           },
           "1": {
            "text": "inicializado",
            "color": "yellow"
           },
           "2": {
            "text": "corriendo",
            "color": "green"
           },
           "3": {
            "text": "detenido",
            "color": "red"
           },
           "4": {
            "text": "pausado",
            "color": "orange"
           },
           "5": {
            "text": "salió",
            "color": "red"
           },
           "6": {
            "text": "borrando",
            "color": "orange"
           },
           "7": {
            "text": "deteniendo",
            "color": "orange"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "salud"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "-1": {
            "text": "sin healthcheck",
            "color": "transparent"
           },
           "0": {
            "text": "sano",
            "color": "green"
           },
           "1": {
            "text": "ENFERMO",
            "color": "red"
           },
           "2": {
            "text": "arrancando",
            "color": "yellow"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "arriba hace"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     }
    ]
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 9
   }
  },
  {
   "type": "timeseries",
   "title": "CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(podman_container_cpu_seconds_total{name=~\"$contenedor\"}[5m])",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Memoria",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "podman_container_mem_usage_bytes{name=~\"$contenedor\"}",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Red entrante",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(podman_container_net_input_total{name=~\"$contenedor\"}[5m])",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Arranques en la última hora",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "changes(podman_container_started_seconds{name=~\"$contenedor\"}[1h])",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "logs",
   "title": "Logs de los contenedores",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"journal\", contenedor=~\"$contenedor\"}",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false,
    "showLabels": false
   },
   "id": 6,
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 24,
    "h": 12
   }
  }
 ],
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "contenedor",
    "label": "Contenedor",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(podman_container_info, name)",
     "refId": "v"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "editable": false
}