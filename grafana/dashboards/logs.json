{
 "uid": "mon-logs",
 "title": "Logs",
 "tags": [
  "servidor",
  "logs"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Volumen por nivel",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (nivel) (count_over_time({job=\"journal\", identificador=~\"$identificador\", unidad_usuario=~\"$unidad_usuario\", unidad=~\"$unidad\", nivel=~\"$nivel\"} |~ `(?i)$buscar` [$__auto]))",
     "legendFormat": "{{nivel}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 7
   }
  },
  {
   "type": "logs",
   "title": "Logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"journal\", identificador=~\"$identificador\", unidad_usuario=~\"$unidad_usuario\", unidad=~\"$unidad\", nivel=~\"$nivel\"} |~ `(?i)$buscar`",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false,
    "showLabels": false
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 20
   }
  }
 ],
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "identificador",
    "label": "Programa",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "identificador",
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "stream": "{job=\"journal\"}",
     "type": 1
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "type": "query",
    "name": "unidad_usuario",
    "label": "Servicio de usuario",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "unidad_usuario",
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "stream": "{job=\"journal\"}",
     "type": 1
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "type": "query",
    "name": "unidad",
    "label": "Servicio del sistema",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "unidad",
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "stream": "{job=\"journal\"}",
     "type": 1
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "type": "query",
    "name": "nivel",
    "label": "Nivel",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "nivel",
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "stream": "{job=\"journal\"}",
     "type": 1
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "type": "textbox",
    "name": "buscar",
    "label": "Buscar",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "editable": false
}