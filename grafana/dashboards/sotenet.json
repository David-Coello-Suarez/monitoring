{
 "uid": "mon-sotenet",
 "title": "Sotenet",
 "description": "Consola y API de Sotenet: métricas de Traefik (Prometheus), logs del backend y registro de acceso (Loki).",
 "tags": [
  "servidor",
  "apps",
  "sotenet"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": false,
 "annotations": {
  "list": []
 },
 "links": [
  {
   "title": "Tráfico",
   "type": "link",
   "url": "/d/mon-trafico",
   "icon": "dashboard"
  },
  {
   "title": "Seguridad",
   "type": "link",
   "url": "/d/mon-seguridad",
   "icon": "dashboard"
  }
 ],
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "servicio",
    "label": "Servicio",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(traefik_service_requests_total{service=~\"(backend|frontend)@.*\"}, service)",
     "refId": "servicio"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": "(backend|frontend)@.*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "type": "textbox",
    "name": "correlationId",
    "label": "correlationId",
    "query": "",
    "current": {
     "selected": false,
     "text": "",
     "value": ""
    }
   },
   {
    "type": "custom",
    "name": "estado",
    "label": "Estado HTTP",
    "query": "Todos : .+,4xx : 4..,5xx : 5..,401 y 429 : 401|429",
    "multi": false,
    "includeAll": false,
    "current": {
     "selected": true,
     "text": "Todos",
     "value": ".+"
    }
   },
   {
    "type": "custom",
    "name": "origen",
    "label": "Origen",
    "query": "Solo externo : no,Todo (con sondas e internas) : si|no",
    "multi": false,
    "includeAll": false,
    "current": {
     "selected": true,
     "text": "Solo externo",
     "value": "no"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Tráfico (métricas de Traefik)",
   "collapsed": false,
   "panels": [],
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "Peticiones por segundo",
   "description": "Tasa de peticiones de los servicios elegidos.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(traefik_service_requests_total{service=~\"$servicio\"}[$__rate_interval]))",
     "refId": "A",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "queryType": "instant"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Errores 5xx",
   "description": "Porcentaje de respuestas 5xx sobre el total.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(traefik_service_requests_total{service=~\"$servicio\",code=~\"5..\"}[$__rate_interval])) / sum(rate(traefik_service_requests_total{service=~\"$servicio\"}[$__rate_interval]))",
     "refId": "A",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "queryType": "instant"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Latencia p95",
   "description": "Percentil 95 de la duración de las peticiones.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$servicio\"}[$__rate_interval])))",
     "refId": "A",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "queryType": "instant"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "sin datos",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Servicios caídos",
   "description": "Servidores que Traefik marca caídos (requiere healthCheck en el servicio).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(traefik_service_server_up{service=~\"(backend|frontend)@.*\"} == 0) or vector(0)",
     "refId": "A",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "queryType": "instant"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
