  {
   "type": "logs",
   "title": "Peticiones",
   "description": "Estado, método, ruta, IP real, router y duración en ns. Filtros: origen y estado.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{contenedor=\"sotenet-traefik\"} |= `RequestPath` | json | __error__=\"\" | label_format ip=request_Cf_Connecting_Ip,ruta=RequestPath,estado=DownstreamStatus,metodo=RequestMethod,ua=request_User_Agent,duracion=Duration,router=RouterName,servicio=ServiceName | label_format interno=`{{ if or (hasPrefix \"Blackbox\" .ua) (hasPrefix \"10.\" .ip) (hasPrefix \"127.\" .ip) (eq .ip \"::1\") (eq .ip \"-\") (eq .ip \"\") }}si{{ else }}no{{ end }}` | interno=~\"$origen\" | estado=~\"$estado\" | line_format `{{.estado}} {{.metodo | printf \"%-6s\"}} {{.ruta}} {{.ip}} {{.router}} {{.duracion}}ns [{{.ua}}]`",
     "refId": "A",
     "legendFormat": "",
     "range": true,
     "queryType": "range"
    }
