     "expr": "{contenedor=\"sotenet-backend\"} | json | __error__=\"\" | level >= 50 | req_id=~\"(?i).*$correlationId.*\" | line_format `{{.level}} {{.req_id}} {{.req_method}} {{.req_url}} {{.res_statusCode}} {{.msg}}`",
     "refId": "A",
