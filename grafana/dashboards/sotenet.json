  {
   "type": "logs",
   "title": "Errores del backend",
   "description": "Nivel 50 o más. Filtra con la variable correlationId (req.id).",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
