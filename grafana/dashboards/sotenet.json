  {
   "type": "timeseries",
   "title": "Registros del backend por nivel",
   "description": "Niveles pino: 40 aviso, 50 error, 60 fatal.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (level) (count_over_time({contenedor=\"sotenet-backend\"} | json | __error__=\"\" | level >= 40 [$__auto]))",
